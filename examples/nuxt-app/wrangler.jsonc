{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuxt-app-oidc",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "observability": {
    "enabled": false
  }
}
