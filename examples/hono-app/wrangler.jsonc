{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hono-app-oidc",
  "compatibility_date": "2025-11-09",
  "main": "./src/index.tsx",
  "vars": {
    "AUTH_ISSUER": "https://stubidp.cerberauth.com",
    "AUTH_REDIRECT_URI": "https://hono-app-oidc.cerberauth.workers.dev/auth/callback",
    "AUTH_POST_LOGOUT_REDIRECT_URI": "https://hono-app-oidc.cerberauth.workers.dev/"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}